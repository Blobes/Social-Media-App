# ==========================================
# BASE & USER PROFILE
# ==========================================

### Test User API Base Route
GET {{baseUrl}}/user

### Get User Profile
GET {{baseUrl}}/user/{{user1ID}}

### Update Basic Info
PATCH {{baseUrl}}/user/update/basic
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "firstName": "Nick",
  "lastName": "Doe"
}

### Update Demographic Info
PATCH {{baseUrl}}/user/update/demo
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "gender": "male",
  "dateOfBirth": "1990-12-12",
  "location": "Iyana Ipaja, Lagos, Nigeria"
}

### Update Profile Image
PATCH {{baseUrl}}/user/update/profile-image
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "imageType": "PROFILE",
  "url": "https://api.dicebear.com/7.x/avataaars/svg?seed=Sarah",
  "fileKey": "test-key",
  "mimeType": "image/jpeg"
}

### Remove Profile Image
DELETE {{baseUrl}}/user/delete/profile-image
Authorization: Bearer {{authToken}}


# ==========================================
# ACCOUNT MANAGEMENT
# ==========================================

### Initiate Email Change
POST {{baseUrl}}/user/change-email/initiate
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "newEmail": "nick@gmail.co"
}

### Finalize Email Change
PATCH {{baseUrl}}/user/change-email/finalize
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "email": "nick@gmail.co",
  "code": "123567"
}

### Cancel Email Change
POST {{baseUrl}}/user/change-email/cancel
Authorization: Bearer {{authToken}}

### Change Username
POST {{baseUrl}}/user/change-username
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "newUsername": "fun_staker"
}

### Initiate Phone Change
POST {{baseUrl}}/user/change-phone/initiate
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "phoneNumber": "+2348012345678"
}

### Finalize Phone Change
PATCH {{baseUrl}}/user/change-phone/finalize
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "phoneNumber": "+2348012345678",
  "code": "123456"
}

### Initiate Password Reset
POST {{baseUrl}}/user/reset-password/initiate
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "identifier": "officialblobes6457@gmail.com"
}

### Set Password
PATCH {{baseUrl}}/user/set-password
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "newPassword": "NickPassword123!"
}

### Change Account Status
PATCH {{baseUrl}}/user/account/status
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "status": "SUSPENDED"
}

### Delete Account
DELETE {{baseUrl}}/user/account/delete
Authorization: Bearer {{authToken}}


# ==========================================
# SOCIAL RELATIONSHIPS
