PATCH {{baseUrl}}/user/submit-doc
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "documentType": "PASSPORT",
  "documentUrl": "https://example.com/doc.pdf"
}

### Review ID Document
PATCH {{baseUrl}}/user/review-doc
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "requestId": "69aa38047ef187d34dba2899",
  "status": "APPROVED"
}


# ==========================================
# USER SETTINGS
# ==========================================

### Get User Settings
GET {{baseUrl}}/user/settings
Authorization: Bearer {{authToken}}

### Update Display Settings
PATCH {{baseUrl}}/user/settings/display
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "theme": "DARK",
  "showSensitiveMedia": true
}

### Update Notification Settings
PATCH {{baseUrl}}/user/settings/notifications
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "push": {
    "enabled": true,
    "likes": true
  }
}

### Update Privacy Settings
PATCH {{baseUrl}}/user/settings/privacy
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "isPrivateAccount": false,
  "directMessaging": "EVERYONE"
}

### Add Muted Words
POST {{baseUrl}}/user/settings/muted-words
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "words": ["spam", "spoiler"]
}

### Remove Muted Words
DELETE {{baseUrl}}/user/settings/muted-words
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "words": ["spam"]
}

### Sync User Topics
PATCH {{baseUrl}}/user/settings/topic
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "topicIds": ["69aa38047ef187d34dba2899"]
}

### Remove User Topics
DELETE {{baseUrl}}/user/settings/topic
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "topicIds": ["69aa38047ef187d34dba2899"]
}