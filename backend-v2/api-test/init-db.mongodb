// init-db.mongodb
use("funstakes");

// 1. Create Collections
const collections = [
  "users",
  "follows",
  "gists",
  "gist_likes",
  "post_contents",
  "bookmarks",
];

collections.forEach((col) => {
  if (!db.getCollectionNames().includes(col)) {
    db.createCollection(col);
    print(`✅ Created collection: ${col}`);
  } else {
    print(`ℹ️ Collection ${col} already exists.`);
  }
});

// 2. Set up Essential Indexes (Safety first!)
db.users.createIndex({ email: 1 }, { unique: true });
db.users.createIndex({ username: 1 }, { unique: true });

// Social Logic: Prevent duplicate follows
db.follows.createIndex({ followerId: 1, followingId: 1 }, { unique: true });
db.follows.createIndex({ followingId: 1 });
// Feed Logic: Fast sorting
db.gists.createIndex({ status: 1, createdAt: -1 });

// Like Logic: One like per user per gist
db.gist_likes.createIndex({ gistId: 1, userId: 1 }, { unique: true });

// 1. Bookmark Safety
db.bookmarks.createIndex({ userId: 1, postId: 1 }, { unique: true });

// 2. PostContent Performance
db.post_contents.createIndex({ postId: 1, isLatest: 1 });
db.post_contents.createIndex({ postId: 1, version: -1 });

// 3. Final Seed
db.system_init.updateOne(
  { id: "version_control" },
  {
    $set: {
      project: "Funstakes",
      initDate: new Date(),
      region: "AWS Cape Town",
    },
  },
  { upsert: true },
);

print("🚀 Funstakes database and core indexes initialized!");
