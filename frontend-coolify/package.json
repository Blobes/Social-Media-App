{
  "name": "funstakes",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo run check-types",
    "clean": "turbo clean && rm -rf node_modules **/.next"
  },
  "devDependencies": {
    "next": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=9.0.7"
    }
  }
}
