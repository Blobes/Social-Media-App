{
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "target": "es2020",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["@types/wicg-file-system-access"],
    "incremental": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["development"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@repo/assets": ["./packages/assets/index.ts"],
      "@repo/core": ["./packages/core/index.ts"],
      "@repo/features": ["./packages/features/index.ts"],
      "@repo/helpers": ["./packages/helpers/index.ts"],
      "@repo/shared-hooks": ["./packages/shared-hooks/index.ts"],
      "@repo/shared-ui": ["./packages/shared-ui/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx"
  ],
  "exclude": ["**/node_modules", ".next"]
}
