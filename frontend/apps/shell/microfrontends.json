{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "applications": {
    "funstakes-shell": {
      "packageName": "@repo/shell",
      "development": {
        "fallback": "funstakes.vercel.app"
      }
    },
    "funstakes-auth": {
      "packageName": "@repo/auth",
      "development": {
        "local": 3002
      },
      "routing": [
        {
          "paths": ["/login", "/signup"]
        }
      ]
    }
  },
  "options": {
    "localProxyPort": 3001
  }
}
